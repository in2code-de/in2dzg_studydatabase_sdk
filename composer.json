{
    "name": "in2code/in2dzg_studydatabase_sdk",
    "description": "PHP-Client für die lesende JSON-API der Studienportal-Datenbank (generiert mit OpenAPI Generator)",
    "type": "library",
    "license": "GPL-2.0",
    "keywords": [
        "studienportal",
        "api",
        "sdk",
        "openapi"
    ],
    "authors": [
        {
            "name": "in2code GmbH",
            "homepage": "https://www.in2code.de"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.3 || ^8.0",
        "guzzlehttp/psr7": "^1.7 || ^2.0 || ^3.0",
        "psr/http-client": "^1.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.5"
    },
    "autoload": {
        "psr-4": {
            "In2code\\In2DzgStudyDatabase\\": "lib/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
